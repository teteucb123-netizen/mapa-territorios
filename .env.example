# Caminho do arquivo do banco SQLite. Em produção, aponte para um disco
# persistente (ver README.md). Se omitido, usa ./data/app.db.
DB_PATH=./data/app.db

# Servidores de roteamento/geocodificação (OpenStreetMap). Os valores abaixo
# são os servidores públicos gratuitos — deixe em branco para usá-los.
# Troque apenas se for hospedar sua própria instância OSRM/Nominatim.
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
